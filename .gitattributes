* text=auto eol=lf

# Keep executable/configuration sources portable across Linux training hosts.
*.sh text eol=lf
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.jsonl text eol=lf
*.md text eol=lf
Dockerfile* text eol=lf

# Never apply text conversion to media assets.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
*.mp3 binary
*.mp4 binary
*.avi binary
*.wav binary
*.flac binary
